Screen {
    background: $surface;
    color: $text;
}

#shell {
    height: 100%;
}

#mode-header {
    height: 4;
    padding-top: 1;
    background: $panel;
    border-bottom: solid $accent;
}

#mode-tabs {
    width: 1fr;
}

#mode-tabs Tab.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#project-selector {
    width: 34;
    border: none;
}

#explorer {
    height: 1fr;
}

#filter-pane {
    width: 20%;
    min-width: 24;
    border-right: solid $primary-background;
    padding: 0 1;
}

#results-pane {
    width: 30%;
    border-right: solid $primary-background;
}

#inspector {
    width: 50%;
    padding: 0 1;
}

.pane-title {
    height: 2;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.filter-label {
    margin-top: 1;
    color: $text-muted;
}

#result-list {
    height: 1fr;
}

#result-list ListItem {
    padding: 1 1 0 1;
    height: auto;
    border-bottom: solid $primary-background;
}

#command-menu {
    display: none;
    height: auto;
    max-height: 16;
    border: solid $accent;
    background: $panel;
}

#command-menu.visible {
    display: block;
}

#pagination {
    height: 3;
    align-horizontal: center;
}

#pagination Button {
    min-width: 12;
}

#page-label {
    width: 1fr;
    content-align: center middle;
}

#source-meta {
    height: auto;
    min-height: 3;
    color: $text-muted;
    padding: 0 1 1 1;
}

#source-text {
    height: 1fr;
    border: none;
}

#docs-outline {
    display: none;
    height: 35%;
    min-height: 6;
    max-height: 18;
    border-bottom: solid $primary-background;
    margin-bottom: 1;
}

#inspector-markdown {
    height: 1fr;
}

#source-action-bar {
    height: 5;
    padding: 0 1;
    background: #171b22;
    border-top: solid #3b82f6;
}

#source-action-label {
    height: 1;
    padding-left: 1;
    color: #94a3b8;
    text-style: bold;
}

#source-actions {
    height: 3;
    align-horizontal: left;
}

.crud-action {
    min-width: 10;
    width: auto;
    height: 3;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    border: none;
}

#source-new {
    background: #164e63;
    color: #cffafe;
}

#source-edit {
    background: #273244;
    color: #dbeafe;
}

#source-delete {
    background: #5f1d2a;
    color: #ffe4e6;
}

#source-forget {
    background: #5a3a08;
    color: #fef3c7;
}

#source-promote {
    background: #14532d;
    color: #dcfce7;
}

.crud-action:focus {
    border: tall #f8fafc;
    text-style: bold;
}

#command-input {
    height: 3;
    border-top: solid $accent;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

.compact #filter-pane {
    display: none;
}

.compact #results-pane {
    width: 50%;
}

.compact #inspector {
    width: 50%;
}

.narrow #inspector {
    display: none;
}

.narrow #results-pane {
    width: 100%;
}

ModalScreen {
    align: center middle;
    background: $background 70%;
}

.modal-card {
    width: 80%;
    height: 80%;
    max-width: 110;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

.confirm-card {
    width: 64;
    height: auto;
    max-height: 18;
}

.edit-card {
    width: 80%;
    height: 70%;
}

.create-source-card {
    width: 80%;
    height: 78%;
}

.modal-note {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.field-label {
    height: 1;
    color: $accent;
    text-style: bold;
    margin-top: 1;
}

.source-viewer-card {
    width: 94%;
    height: 94%;
    max-width: 180;
}

#source-viewer-meta {
    height: auto;
    min-height: 2;
    color: $text-muted;
}

#source-viewer-text {
    height: 1fr;
}

.modal-title {
    height: 2;
    color: $accent;
    text-style: bold;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.modal-actions Button {
    margin-left: 1;
}

#record-editor {
    height: 1fr;
}

#source-editor {
    height: 1fr;
    min-height: 10;
}

#sources-table {
    height: 1fr;
}

Tab.empty {
    color: $text-disabled;
}

Tab.risk {
    color: $warning;
    text-style: bold;
}
