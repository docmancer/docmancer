Screen {
    background: $surface;
    color: $text;
}

StartupScreen {
    align: center middle;
    background: $surface;
}

#startup-card {
    width: 72;
    height: auto;
    padding: 2 4;
    background: $panel;
    border: round $border;
    border-title-color: $accent;
    content-align: center middle;
}

#startup-title {
    height: 2;
    color: $accent;
    text-align: center;
    text-style: bold;
}

#startup-spinner {
    height: 3;
    margin: 1 0;
}

#startup-detail {
    height: auto;
    color: $text-muted;
    text-align: center;
}

#shell {
    height: 100%;
}

#mode-header {
    height: 4;
    padding-top: 1;
    background: $panel;
    border-bottom: solid $border;
}

#mode-tabs {
    width: 1fr;
}

#mode-tabs Tab {
    padding: 0 2;
    color: $text-muted;
}

#mode-tabs Tab:hover {
    color: $text;
    text-style: bold;
}

#mode-tabs Tab.-active {
    background: $surface-lighten-1;
    color: $accent;
    text-style: bold;
}

#project-selector {
    width: 34;
    border: none;
}

#explorer {
    height: 1fr;
}

#filter-pane {
    width: 20%;
    min-width: 24;
    border-right: solid $border-blurred;
    padding: 0 2;
    background: $background;
}

#results-pane {
    width: 30%;
    border-right: solid $border-blurred;
    padding: 0 1;
}

#inspector {
    width: 50%;
    padding: 0 2;
}

.pane-title {
    height: 2;
    padding: 1 0 0 2;
    border-left: thick $accent;
    color: $accent;
    text-style: bold;
}

.filter-label {
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

#audit-context-label,
#audit-hook-claude-code,
#audit-hook-codex,
#audit-how-it-works,
#context-manage-label,
#context-reset-personal,
#context-reset-team,
#context-how-it-works {
    display: none;
}

#audit-context-label {
    margin-top: 2;
    color: $accent;
    text-style: bold;
}

.audit-hook-card {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 0 2;
    content-align: left middle;
    text-align: left;
    background: $panel;
    color: $text-muted;
    border: none;
    border-left: thick $surface-lighten-2;
}

.audit-hook-card:hover {
    background: $boost;
    border-left: thick $accent;
}

.audit-hook-card.connected {
    color: $success;
    border-left: thick $success;
}

.audit-help-button {
    width: 100%;
    height: 3;
    margin-top: 1;
    background: transparent;
    color: $text-muted;
    border: none;
    border-left: thick $surface-lighten-1;
}

.audit-help-button:hover {
    background: $boost;
    color: $text;
    border-left: thick $accent;
}

#context-manage-label {
    margin-top: 2;
    color: $accent;
    text-style: bold;
}

.context-manage-button {
    width: 100%;
    height: 4;
    margin-top: 1;
    padding: 0 2;
    content-align: left middle;
    text-align: left;
    background: $panel;
    color: $warning;
    border: none;
    border-left: thick $warning-darken-1;
}

.context-manage-button:hover {
    background: $boost;
    border-left: thick $warning;
}

.context-manage-button:disabled {
    color: $text-disabled;
    border-left: thick $surface-lighten-1;
}

.context-help-button {
    width: 100%;
    height: 3;
    margin-top: 1;
    background: transparent;
    color: $text-muted;
    border: none;
    border-left: thick $surface-lighten-1;
}

.context-help-button:hover {
    background: $boost;
    color: $text;
    border-left: thick $accent;
}

#result-list {
    height: 1fr;
    background: transparent;
    scrollbar-size: 1 1;
}

#result-list ListItem {
    padding: 1 1 1 2;
    height: auto;
    background: transparent;
    border-left: thick $surface;
    border-bottom: solid $panel;
}

#result-list ListItem:hover {
    background: $boost;
}

#result-list ListItem.-highlight {
    background: $surface-lighten-1;
    border-left: thick $accent;
}

#result-list:focus ListItem.-highlight {
    background: $surface-lighten-1;
    border-left: thick $accent;
}

#command-menu {
    display: none;
    height: auto;
    max-height: 16;
    padding: 0 1;
    border: round $accent;
    background: $panel;
}

#command-menu.visible {
    display: block;
}

#pagination {
    height: 3;
    padding: 0 1;
    align-horizontal: center;
}

#pagination Button {
    min-width: 12;
    height: 3;
    border: none;
    background: $surface-lighten-1;
    color: $text-muted;
    text-style: bold;
}

#pagination Button:hover {
    background: $surface-lighten-2;
    color: $text;
}

#pagination Button:disabled {
    background: $surface;
    color: $text-disabled;
}

#page-label {
    width: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#source-meta {
    height: auto;
    min-height: 3;
    color: $text-muted;
    padding: 0 1 1 1;
}

#source-text {
    height: 1fr;
    border: none;
}

#docs-outline {
    display: none;
    height: 35%;
    min-height: 6;
    max-height: 18;
    border-bottom: solid $primary-background;
    margin-bottom: 1;
}

#inspector-markdown {
    height: 1fr;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#source-action-bar {
    height: 5;
    padding: 0 1;
    background: $panel;
    border-top: solid $border;
}

#source-action-header {
    height: 1;
}

#source-action-label {
    width: 1fr;
    height: 1;
    padding-left: 1;
    border-left: thick $accent;
    color: $accent;
    text-style: bold;
}

#context-loading {
    display: none;
    width: 12;
    height: 1;
    color: $accent;
    background: transparent;
}

#source-actions {
    height: 3;
    align-horizontal: left;
}

.crud-action {
    min-width: 10;
    width: auto;
    height: 3;
    padding: 0 2;
    margin-right: 1;
    text-style: bold;
    border: none;
}

.crud-action:hover {
    text-style: bold reverse;
}

#source-new {
    background: #313244;
    color: #94e2d5;
}

#source-edit {
    background: #313244;
    color: #89b4fa;
}

#source-delete {
    background: #302233;
    color: #f38ba8;
}

#source-forget {
    background: #302a23;
    color: #fab387;
}

#source-promote {
    background: #26302a;
    color: #a6e3a1;
}

.crud-action:focus {
    outline: round $accent;
    text-style: bold;
}

#command-input {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    background: $surface-lighten-1;
    border: round $border;
    color: $text;
}

#command-input:focus {
    border: round $accent;
    background: $surface-lighten-1;
}

#status-bar {
    height: 1;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

.compact #filter-pane {
    display: none;
}

.compact #results-pane {
    width: 50%;
}

.compact #inspector {
    width: 50%;
}

.narrow #inspector {
    display: none;
}

.narrow #results-pane {
    width: 100%;
}

ModalScreen {
    align: center middle;
    background: $background 70%;
}

.modal-card {
    width: 80%;
    height: 80%;
    max-width: 110;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

.confirm-card {
    width: 64;
    height: auto;
    max-height: 18;
}

.busy-card {
    width: 60;
    height: auto;
    max-height: 14;
    content-align: center middle;
}

.busy-card #busy-spinner {
    height: 3;
    margin: 1 0;
}

.busy-card #busy-detail {
    height: auto;
    color: $text-muted;
    text-align: center;
}

.edit-card {
    width: 80%;
    height: 70%;
}

.create-source-card {
    width: 80%;
    height: 78%;
}

.modal-note {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

.field-label {
    height: 1;
    color: $accent;
    text-style: bold;
    margin-top: 1;
}

.source-viewer-card {
    width: 94%;
    height: 94%;
    max-width: 180;
}

#source-viewer-meta {
    height: auto;
    min-height: 2;
    color: $text-muted;
}

#source-viewer-text {
    height: 1fr;
}

.modal-title {
    height: 2;
    color: $accent;
    text-style: bold;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

.modal-actions Button {
    margin-left: 1;
}

#record-editor {
    height: 1fr;
}

#source-editor {
    height: 1fr;
    min-height: 10;
}

#sources-table {
    height: 1fr;
}

Tab.empty {
    color: $text-disabled;
}

Tab.risk {
    color: $warning;
    text-style: bold;
}
